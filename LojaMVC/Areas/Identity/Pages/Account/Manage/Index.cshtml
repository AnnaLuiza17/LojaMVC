@page
@model IndexModel
@{
    ViewData["Title"] = "Meu Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<style>
    .profile-card {
        background: #ffffff;
        padding: 30px;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        max-width: 600px;
    }

    .profile-title {
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #cbd5e1;
    }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

    .btn-save {
        background: #2563eb;
        color: white;
        font-weight: 600;
        border-radius: 10px;
        padding: 11px;
        width: 100%;
        border: none;
        transition: 0.2s;
    }

        .btn-save:hover {
            background: #1d4ed8;
            color: white;
        }
</style>

<div class="profile-card">
    <h3 class="profile-title">@ViewData["Title"]</h3>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <!-- E-mail (Apenas Leitura) -->
        <div class="form-floating mb-3">
            <input asp-for="Username" class="form-control" placeholder="E-mail" disabled />
            <label asp-for="Username" class="form-label">E-mail (Não alterável)</label>
        </div>

        <!-- Campo Nome Completo -->
        <div class="form-floating mb-3">
            <input asp-for="Input.NomeCompleto" class="form-control" placeholder="Nome Completo" />
            <label asp-for="Input.NomeCompleto" class="form-label">Nome Completo</label>
            <span asp-validation-for="Input.NomeCompleto" class="text-danger"></span>
        </div>

        <!-- Campo Idade -->
        <div class="form-floating mb-3">
            <input asp-for="Input.Idade" class="form-control" type="number" placeholder="Idade" />
            <label asp-for="Input.Idade" class="form-label">Idade</label>
            <span asp-validation-for="Input.Idade" class="text-danger"></span>
        </div>

        <!-- Campo Telefone -->
        <div class="form-floating mb-3">
            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Telefone" />
            <label asp-for="Input.PhoneNumber" class="form-label">Telefone</label>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>

        <button id="update-profile-button" type="submit" class="btn btn-save">Salvar Alterações</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}