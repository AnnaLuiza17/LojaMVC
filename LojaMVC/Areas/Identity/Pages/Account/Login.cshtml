@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<style>
    .login-container {
        max-width: 500px;
        margin: 50px auto;
    }

    .login-card {
        padding: 35px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .login-title {
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .login-subtitle {
        color: #64748b;
        margin-bottom: 25px;
    }

    .form-floating {
        margin-bottom: 18px;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #cbd5e1;
    }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

    .form-check {
        margin-bottom: 20px;
    }

    .form-check-label {
        color: #334155;
    }

    .btn-login {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 11px;
        font-weight: 600;
        background: #2563eb;
        color: white;
        transition: 0.2s;
    }

        .btn-login:hover {
            background: #1d4ed8;
            color: white;
            transform: translateY(-1px);
        }

    .login-links {
        margin-top: 25px;
        text-align: center;
    }

        .login-links p {
            margin-bottom: 10px;
        }

        .login-links a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
        }

            .login-links a:hover {
                text-decoration: underline;
            }

    .login-logo {
        text-align: center;
        margin-bottom: 25px;
    }

        .login-logo span {
            color: #2563eb;
            font-size: 2rem;
            font-weight: 800;
        }
</style>

<div class="login-container">

    <div class="login-card">

        <div class="login-logo">
            <span>LojaMVC</span>
        </div>

        <h1 class="login-title text-center">
            @ViewData["Title"]
        </h1>

        <p class="login-subtitle text-center">
            Entre na sua conta para continuar
        </p>

        <hr />

        <form id="account" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert">
            </div>

            <div class="form-floating mb-3">

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="nome@exemplo.com" />

                <label asp-for="Input.Email">
                    E-mail
                </label>

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>

            </div>

            <div class="form-floating mb-3">

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Senha" />

                <label asp-for="Input.Password">
                    Senha
                </label>

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>

            </div>

            <div class="form-check">

                <input class="form-check-input"
                       asp-for="Input.RememberMe" />

                <label class="form-check-label"
                       asp-for="Input.RememberMe">

                    Lembrar de mim

                </label>

            </div>

            <button id="login-submit"
                    type="submit"
                    class="btn btn-login">

                Entrar

            </button>

            <div class="login-links">

                <p>
                    <a id="forgot-password"
                       asp-page="./ForgotPassword">
                        Esqueceu sua senha?
                    </a>
                </p>

                <p>
                    Ainda não possui uma conta?
                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        Cadastre-se
                    </a>
                </p>

                <p>
                    <a id="resend-confirmation"
                       asp-page="./ResendEmailConfirmation">
                        Reenviar confirmação de e-mail
                    </a>
                </p>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}