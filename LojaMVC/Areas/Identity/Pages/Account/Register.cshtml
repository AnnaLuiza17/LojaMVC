@page
@model RegisterModel

@{
    ViewData["Title"] = "Cadastro";
}

<style>
    .register-container {
        max-width: 500px;
        margin: 50px auto;
    }

    .register-card {
        padding: 35px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .register-logo {
        text-align: center;
        margin-bottom: 20px;
    }

        .register-logo span {
            color: #2563eb;
            font-size: 2rem;
            font-weight: 800;
        }

    .register-title {
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 8px;
        text-align: center;
    }

    .register-subtitle {
        color: #64748b;
        text-align: center;
        margin-bottom: 25px;
    }

    .form-floating {
        margin-bottom: 18px;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #cbd5e1;
    }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

    .btn-register {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 11px;
        font-weight: 600;
        background: #2563eb;
        color: white;
        transition: 0.2s;
    }

        .btn-register:hover {
            background: #1d4ed8;
            color: white;
            transform: translateY(-1px);
        }

    .login-link {
        display: block;
        text-align: center;
        margin-top: 22px;
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
    }

        .login-link:hover {
            text-decoration: underline;
        }

    .external-login {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

        .external-login h3 {
            color: #334155;
            font-size: 1rem;
            font-weight: 600;
            text-align: center;
        }

        .external-login p {
            color: #64748b;
            font-size: 0.9rem;
            text-align: center;
        }

        .external-login a {
            color: #2563eb;
        }
</style>

<div class="register-container">

    <div class="register-card">

        <div class="register-logo">
            <span>LojaMVC</span>
        </div>

        <h1 class="register-title">
            @ViewData["Title"]
        </h1>

        <p class="register-subtitle">
            Crie sua conta para acessar a loja
        </p>

        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert">
            </div>

            <!-- Campo Nome Completo -->
            <div class="form-floating mb-3">
                <input asp-for="Input.NomeCompleto"
                       class="form-control"
                       autocomplete="name"
                       aria-required="true"
                       placeholder="Seu nome completo" />

                <label asp-for="Input.NomeCompleto">
                    Nome Completo
                </label>

                <span asp-validation-for="Input.NomeCompleto"
                      class="text-danger">
                </span>
            </div>

            <!-- Campo Idade -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Idade"
                       class="form-control"
                       type="number"
                       aria-required="true"
                       placeholder="Sua idade" />

                <label asp-for="Input.Idade">
                    Idade
                </label>

                <span asp-validation-for="Input.Idade"
                      class="text-danger">
                </span>
            </div>

            <!-- Campo E-mail -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="nome@exemplo.com" />

                <label asp-for="Input.Email">
                    E-mail
                </label>

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>
            </div>

            <!-- Campo Senha -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Senha" />

                <label asp-for="Input.Password">
                    Senha
                </label>

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>
            </div>

            <!-- Campo Confirmar Senha -->
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Confirmar senha" />

                <label asp-for="Input.ConfirmPassword">
                    Confirmar senha
                </label>

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger">
                </span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="btn btn-register">
                Criar minha conta
            </button>

        </form>

        <a asp-page="./Login"
           asp-route-returnUrl="@Model.ReturnUrl"
           class="login-link">
            Já possui uma conta? Entrar
        </a>

        @{
            if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="external-login">
                    <h3>Cadastrar usando outro serviço</h3>
                    <form id="external-account"
                          asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post"
                          class="form-horizontal">
                        <p>
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        class="btn btn-primary"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Cadastrar usando @provider.DisplayName">
                                    @provider.DisplayName
                                </button>
                            }
                        </p>
                    </form>
                </div>
            }
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}