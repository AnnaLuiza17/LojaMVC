@model IEnumerable<LojaMVC.Models.Cliente>

@{
    ViewData["Title"] = "Index";
}

<style>
    .index-container {
        max-width: 1000px;
        margin: 40px auto;
    }

    .index-card {
        padding: 35px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .index-title {
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .index-subtitle {
        color: #64748b;
        margin-bottom: 20px;
    }

    .create-link {
        display: inline-block;
        margin-bottom: 20px;
        padding: 10px 18px;
        background: #2563eb;
        color: #ffffff;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .create-link:hover {
            background: #1d4ed8;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .client-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
    }

        .client-table thead {
            background: #f8fafc;
        }

        .client-table th {
            color: #334155;
            font-weight: 600;
            padding: 14px;
            border-bottom: 1px solid #e2e8f0;
        }

        .client-table td {
            color: #475569;
            padding: 14px;
            border-bottom: 1px solid #e2e8f0;
        }

        .client-table tbody tr:last-child td {
            border-bottom: none;
        }

        .client-table tbody tr {
            transition: 0.2s;
        }

            .client-table tbody tr:hover {
                background: #f8fafc;
            }

    .action-link {
        text-decoration: none;
        font-weight: 500;
        margin-right: 10px;
    }

    .edit-link {
        color: #2563eb;
    }

        .edit-link:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }

    .details-link {
        color: #64748b;
    }

        .details-link:hover {
            color: #334155;
            text-decoration: underline;
        }

    .delete-link {
        color: #dc2626;
    }

        .delete-link:hover {
            color: #b91c1c;
            text-decoration: underline;
        }
</style>

<div class="index-container">
    <div class="index-card">

        <h1 class="index-title">Clientes</h1>

        <p class="index-subtitle">
            Lista de clientes cadastrados
        </p>

        <p>
            <a asp-action="Create" class="create-link">
                + Novo Cliente
            </a>
        </p>

        <table class="client-table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Nome)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Email)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Idade)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Ativo)
                    </th>
                    <th>
                        Ações
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Nome)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Idade)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Ativo)
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="action-link edit-link">
                                Editar
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="action-link details-link">
                                Detalhes
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="action-link delete-link">
                                Excluir
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
