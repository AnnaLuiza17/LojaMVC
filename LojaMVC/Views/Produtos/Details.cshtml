@model LojaMVC.Models.Produto

@{
    ViewData["Title"] = "Details";
}

<style>
    .details-container {
        max-width: 650px;
        margin: 40px auto;
    }

    .details-card {
        padding: 35px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .details-title {
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .details-subtitle {
        color: #64748b;
        margin-bottom: 10px;
    }

    .product-info {
        margin-top: 20px;
    }

        .product-info dt {
            color: #334155;
            font-weight: 600;
            padding: 12px 0;
        }

        .product-info dd {
            color: #64748b;
            padding: 12px 0;
            margin-bottom: 0;
        }

    .edit-link {
        display: inline-block;
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
        margin-right: 15px;
    }

        .edit-link:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }

    .back-link {
        display: inline-block;
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
    }

        .back-link:hover {
            text-decoration: underline;
        }
</style>

<div class="details-container">
    <div class="details-card">

        <h1 class="details-title">@ViewData["Title"]</h1>

        <h4 class="details-subtitle">Produto</h4>

        <hr />

        <dl class="row product-info">

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Nome)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Nome)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Preco)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Preco)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Estoque)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Estoque)
            </dd>

        </dl>

        <hr />

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model?.IdProduto"
               class="edit-link">
                Editar
            </a>

            <a asp-action="Index" class="back-link">
                ← Voltar para a Lista
            </a>
        </div>

    </div>
</div>
