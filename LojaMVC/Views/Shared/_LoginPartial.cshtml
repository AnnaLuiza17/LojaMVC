@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<style>
    .identity-nav {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .identity-link {
        color: #334155 !important;
        text-decoration: none;
        font-weight: 500;
        padding: 8px 12px !important;
        border-radius: 8px;
        transition: 0.2s;
    }

        .identity-link:hover {
            color: #2563eb !important;
            background: #eff6ff;
        }

    .identity-user {
        color: #1e3a8a !important;
        font-weight: 600;
    }

    .identity-button {
        color: #dc2626 !important;
        text-decoration: none;
        font-weight: 500;
        padding: 8px 12px !important;
        border-radius: 8px;
        transition: 0.2s;
    }

        .identity-button:hover {
            color: #b91c1c !important;
            background: #fef2f2;
        }

    .identity-register {
        background: #2563eb;
        color: #ffffff !important;
        padding: 8px 15px !important;
        border-radius: 9px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .identity-register:hover {
            background: #1d4ed8;
            color: #ffffff !important;
            transform: translateY(-1px);
        }
</style>

<ul class="navbar-nav identity-nav">

    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">

            <a id="manage"
               class="nav-link identity-link identity-user"
               asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="Gerenciar conta">

                👤 Olá, @UserManager.GetUserName(User)!

            </a>

        </li>

        <li class="nav-item">

            <form id="logoutForm"
                  class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">

                <button id="logout"
                        type="submit"
                        class="nav-link btn btn-link identity-button border-0">

                    Sair

                </button>

            </form>

        </li>
    }
    else
    {
        <li class="nav-item">

            <a class="nav-link identity-link"
               id="login"
               asp-area="Identity"
               asp-page="/Account/Login">

                🔐 Login

            </a>

        </li>

        <li class="nav-item">

            <a class="identity-register"
               id="register"
               asp-area="Identity"
               asp-page="/Account/Register">

                📝 Cadastro

            </a>

        </li>
    }

</ul>
