<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LojaMVC</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LojaMVC.styles.css" asp-append-version="true" />

    <style>
        .navbar-loja {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        .navbar-brand-loja {
            color: #1e3a8a !important;
            font-weight: 800;
            font-size: 1.35rem;
            text-decoration: none;
        }

            .navbar-brand-loja:hover {
                color: #2563eb !important;
            }

        .navbar-link-loja {
            color: #334155 !important;
            font-weight: 500;
            padding: 8px 12px !important;
            margin: 0 2px;
            border-radius: 8px;
            text-decoration: none;
            transition: 0.2s;
        }

            .navbar-link-loja:hover {
                color: #2563eb !important;
                background: #eff6ff;
            }

        .navbar-link-active {
            color: #2563eb !important;
            background: #eff6ff;
        }
    </style>
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-loja mb-3">

            <div class="container-fluid">

                <!-- Logo -->
                <a class="navbar-brand navbar-brand-loja"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    LojaMVC
                </a>

                <!-- Botão para celular -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Menu principal -->
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">

                            <a class="nav-link navbar-link-loja"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Início

                            </a>

                        </li>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">

                                <a class="nav-link navbar-link-loja"
                                   asp-area=""
                                   asp-controller="Clientes"
                                   asp-action="Index">

                                    Clientes

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link navbar-link-loja"
                                   asp-area=""
                                   asp-controller="Produtos"
                                   asp-action="Index">

                                    Produtos

                                </a>

                            </li>
                        }

                    </ul>

                    <!-- Login / Cadastro / Logout -->
                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>

    </header>

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - LojaMVC

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>